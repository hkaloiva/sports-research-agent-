# Copy to .env and adjust if needed. Every default here is zero-cost —
# no setting requires a paid API key. See docs/configuration.md.

# Search provider(s), comma-separated fallback chain, tried in order.
# Options: duckduckgo, wikipedia. Both are free and require no API key.
SEARCH_PROVIDER=duckduckgo,wikipedia

# HTTP timeout (seconds) for search/content requests.
REQUEST_TIMEOUT=15

# How many ranked candidate sources to actually fetch+extract per request.
MAX_SOURCES_TO_FETCH=5

# Local on-disk cache of search results and retrieved pages.
CACHE_ENABLED=true
CACHE_DIR=data/cache
CACHE_TTL_SECONDS=86400

# Optional: use local browser rendering (Playwright) for JS-heavy pages
# instead of plain HTTP. Requires `pip install playwright` and a one-time
# `playwright install chromium` — neither is done automatically. Free,
# but a real download; leave false unless you need it.
USE_BROWSER_FALLBACK=false

# Optional: local LLM assist for extraction, via Ollama
# (https://ollama.com — free, runs entirely on your machine, no cloud
# API). The application works fully without this; it only helps on pages
# the deterministic extractor can't parse. Requires Ollama installed,
# running, and the chosen model already pulled (`ollama pull llama3.1`).
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# Where exports (CSV/JSON/XLSX) are written by default.
OUTPUT_DIR=data/exports
